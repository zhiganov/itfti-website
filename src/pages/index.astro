---
import Base from "../layouts/Base.astro";
import InstallCommands from "../components/InstallCommands.astro";

const repo = "https://github.com/zhiganov/impact-to-funding";
const makes = [
  ["Claim checks", "what you did, kept apart from what it caused, and what counts against it."],
  ["Lessons", "how others' theories of change held up, null results included."],
  ["Support briefs", "funders that fit, with open or closed status checked."],
  ["Theories of change", "rebuilt from what you already have."],
  ["Sponsorship", "GitHub Sponsors profiles and tiers."],
  ["A way in", "skills for existing organisations."],
  ["Impact cards", "a badge and card for a public report."],
];
const together = [
  { rule: "rule-solid", title: "Profiles", text: "Your impact, from your own Bluesky account. Real-account publishing is being checked.", link: ["https://app.itfti.org", "app.itfti.org"] },
  { rule: "rule-solid", title: "Mentors", text: "ItF helps you find mentors, including people you don't know yet, and draft a request you send. A shared pool is planned." },
  { rule: "rule-dash", title: "Guilds", text: "See each other's work and needs in your community's dashboard. Planned." },
  { rule: "rule-dash", title: "Matchmaking", text: "Organisations post needs; builders find work. Format public, matching planned.", link: ["/fti/needs", "Needs format"] },
];
const manifest = `{
  "profile": "fti.discovery/0.1-draft",
  "publisher": { "name": "Example Fund", "website": "https://example.org" },
  "entries": [{
    "entryId": "maintenance-2027",
    "intake": { "mode": "public_application", "cadence": "rolling" }
  }]
}`;
---
<Base
  title="ItFtI: from impact to funding, and back"
  description="Two connected projects that make the way between useful work and funding easier to find, from both ends: Impact to Funding for builders, Funding to Impact for funders."
  current="home"
>
  <section class="hero grid" aria-labelledby="hero-title">
    <img class="seal" src="/itfti-seal.svg" width="1824" height="1820"
      alt="The ItFtI seal: the letters I, t, F, t, I form the walls of a maze, with an entrance at the bottom and an exit at the top." />
    <div class="copy">
      <h1 id="hero-title">Find the way from impact to funding.</h1>
      <p class="lede">A skill that helps builders make an honest case for support, and a file format that lets funders say what they support.</p>
      <div class="entry-actions">
        <a class="slab" href="#install"><span>Builders: <span class="action-phrase">install ItF</span></span></a>
        <a class="slab-ghost" href="/fti/publish"><span>Funders: publish <span class="action-phrase">with FtI</span></span></a>
      </div>
      <p class="entry-note">ItF is free and open source.</p>
      <div class="lane rule-solid">
        <h2><a href="/itf">Impact to Funding</a> <span>builders · experimental</span></h2>
        <p>A skill for your AI agent.</p>
      </div>
      <div class="lane rule-dash">
        <h2><a href="/fti">Funding to Impact</a> <span>funders · draft 0.1</span></h2>
        <p>A file funders publish on their own site. Looking for its first funders.</p>
      </div>
    </div>
  </section>

  <section class="course maze grid" id="maze" aria-labelledby="maze-title">
    <h2 id="maze-title" class="head">The maze</h2>
    <div class="body">
      <p class="big">Builders lose time on vague funding pages. Funders read applications that were never a fit.</p>
    </div>
  </section>

  <section class="course itf grid" id="itf" aria-labelledby="itf-title">
    <div class="head">
      <h2 id="itf-title">Impact to Funding</h2>
      <p class="tag rule-solid">For builders. Experimental, v0.7.0.</p>
    </div>
    <div class="body">
      <p class="big">Claims that hold up, lessons from others' work, and funders that fit.</p>
      <h3>What it helps you do</h3>
      <dl class="publishes">
        {makes.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
      <h3 id="install">Install</h3>
      <p>For Claude Code, Codex CLI or OpenCode. <a href="/itf#limits">Limits</a>.</p>
      <InstallCommands />
      <p class="actions">
        <a class="slab-ghost" href="/itf">How it works</a><a class="slab-ghost" href={repo}>ItF on GitHub</a>
      </p>
    </div>
  </section>

  <section class="course loop grid" id="loop" aria-labelledby="loop-title">
    <h2 id="loop-title" class="head">How the two meet</h2>
    <div class="body">
      <ol class="sides">
        <li><h3>Impact → funding</h3><p>A builder says what they do and what would help it continue.</p></li>
        <li><h3>Funding → impact</h3><p>A funder says what it supports, for whom, how much and by when.</p></li>
      </ol>
    </div>
  </section>

  <section class="course fti grid" id="fti" aria-labelledby="fti-title">
    <div class="head">
      <h2 id="fti-title">Funding to Impact</h2>
      <p class="tag rule-dash">For funders. Draft 0.1, looking for its first funders.</p>
    </div>
    <div class="body">
      <p class="big">Can I tell whether this funder supports work like mine, before I apply?</p>
      <p>A funder publishes <code>fti-manifest.json</code> on its own site. People and agents read it. Built on <a href="https://commongrants.org/">CommonGrants</a>.</p>
      <pre class="snippet"><code>{manifest}</code></pre>
      <p class="actions"><a class="slab" href="/fti/publish">Publish with FtI</a><a class="slab-ghost" href="/fti/format">The file format</a></p>
    </div>
  </section>

  <section class="course together grid" id="together" aria-labelledby="together-title">
    <div class="head">
      <h2 id="together-title">Together</h2>
      <p class="tag rule-solid">Built on ATProto. Your records stay in your own account.</p>
    </div>
    <div class="body">
      <figure class="exhibit shot">
        <div class="window">
          <div class="bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">app.itfti.org/profile/…</span></div>
          <img src="/examples/profile-fictional.png" width="900" height="650" loading="lazy"
            alt="A fictional impact profile for Alex Example: what they're working on, areas of work, and a report marked independently evaluated." />
        </div>
        <figcaption>A fictional profile at app.itfti.org.</figcaption>
      </figure>
      <ul class="ledger">
        {together.map((t) => (
          <li class={t.rule}><strong>{t.title}.</strong> {t.text}{t.link && <> <a href={t.link[0]}>{t.link[1]}</a></>}</li>
        ))}
      </ul>
      <p class="fine">Solid: live. Dashed: planned.</p>
    </div>
  </section>
</Base>

<style>
  .hero { align-items: center; row-gap: 32px; padding-bottom: clamp(40px, 6vw, 96px); }
  .seal { grid-column: 1 / span 6; width: 100%; height: auto; max-height: min(64svh, 640px); object-fit: contain; }
  .copy { grid-column: 7 / span 6; }
  .lede { font-size: var(--step-1); line-height: 1.4; margin-top: 0.7em; }
  .lane { margin-top: 22px; padding-top: 10px; }
  .lane h2 { font-size: var(--step-1); }
  .lane h2 a { text-decoration: none; }
  .lane h2 a:hover { text-decoration: underline; }
  .lane h2 span { font-family: var(--body); font-weight: 600; font-size: max(12px, 0.55em); letter-spacing: 0.12em; text-transform: uppercase; margin-left: 0.5em; white-space: nowrap; }
  .lane p { margin-top: 6px; }
  .entry-actions { margin-top: 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .entry-actions a { display: flex; align-items: center; justify-content: center; min-height: 48px; text-align: center; line-height: 1.2; }
  .action-phrase { white-space: nowrap; }
  .entry-note { margin-top: 10px; font-size: 0.9rem; }

  .head { grid-column: 1 / span 4; align-self: start; position: sticky; top: 24px; }
  .body { grid-column: 5 / span 8; display: grid; gap: 1.1em; min-width: 0; }
  .big { font-family: var(--display); font-weight: 500; font-size: var(--step-1); line-height: 1.3; max-width: 34ch; }
  .tag { margin-top: 14px; padding-top: 10px; font-weight: 600; max-width: 26ch; }

  .example { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 8px solid var(--red); }
  .example > div { padding: 22px 24px; max-width: none; }
  .example > div + div { border-left: 8px solid var(--red); }
  .example h3 { margin-bottom: 0.4em; }
  .hosts { max-width: 560px; }
  .fine { font-size: 0.9rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 0.4em; }

  .sides { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 8px solid var(--red); }
  .sides li { padding: 22px 24px; max-width: none; }
  .sides li + li { border-left: 8px solid var(--red); }
  .sides h3 { margin-bottom: 0.4em; }

  .publishes { display: grid; gap: 0; }
  .publishes div { display: grid; grid-template-columns: 9.5em 1fr; gap: 16px; padding: 0.7em 0; border-bottom: 2px solid var(--red); }
  .publishes dt { font-family: var(--display); font-weight: 700; }
  .publishes dd { margin: 0; max-width: 60ch; }

  .ledger { list-style: none; padding: 0; display: grid; gap: 24px; }
  .ledger li { padding-top: 14px; }
  .exhibit { margin: 0; display: grid; gap: 8px; }
  .exhibit img { width: 100%; max-width: 560px; height: auto; display: block; }
  .exhibit figcaption { font-size: 0.9rem; max-width: 60ch; }
  .snippet { margin: 0; padding: 14px 16px; background: var(--red-wash); overflow-x: auto; font-size: 0.85rem; line-height: 1.5; }
  .snippet code { background: none; padding: 0; }
  .window { max-width: min(440px, calc(100% - 10px)); border: 3px solid var(--red); background: var(--paper); box-shadow: 10px 10px 0 var(--red-wash); }
  .window .bar { display: flex; align-items: center; gap: 12px; padding: 7px 10px; background: var(--red); color: var(--paper); font-size: 0.8rem; }
  .window .dots { display: flex; gap: 5px; }
  .window .dots i { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid var(--paper); }
  .window .url { flex: 1; padding: 2px 8px; background: color-mix(in srgb, var(--paper) 18%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .exhibit .window img { max-width: 100%; }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .seal { grid-column: 1 / -1; max-width: 460px; justify-self: center; max-height: none; }
    .copy, .head, .body { grid-column: 1 / -1; }
    .head { position: static; }
    .sides { grid-template-columns: 1fr; }
    .sides li + li { border-left: 0; border-top: 8px solid var(--red); }
    .example { grid-template-columns: 1fr; }
    .example > div + div { border-left: 0; border-top: 8px solid var(--red); }
    .publishes div { grid-template-columns: 1fr; gap: 2px; }
    .lane h2 span { display: block; margin: 6px 0 0; }
  }
  /* Phones: keep both audience actions together, before the explanatory lanes. */
  @media (max-width: 720px) {
    .hero { row-gap: 20px; }
    .seal { max-width: 210px; justify-self: start; }
    .entry-actions { grid-template-columns: 1fr; margin-top: 18px; gap: 12px; }
  }
</style>
