---
import Base from "../../layouts/Base.astro";
---
<Base
  title="Thanks · ItFtI"
  description="Thanks for writing to us about publishing with Funding to Impact."
  current="fti"
>
  <section class="grid thanks" aria-labelledby="t">
    <div class="body">
      <h1 id="t">Thanks. We've got your message.</h1>
      <p class="big">We'll reply by email.</p>
      <p>Meanwhile, the <a href="/fti/format">file format</a> and the <a href="/fti/publish">publishing guide</a> show what a funder's file looks like.</p>
      <p class="actions"><a class="slab-ghost" href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>

<style>
  .thanks { padding-block: clamp(48px, 8vw, 120px); }
  .body { grid-column: 1 / span 8; display: grid; gap: 1.1em; }
  .big { font-family: var(--display); font-weight: 500; font-size: var(--step-2); line-height: 1.3; }
  .actions { display: flex; gap: 14px; margin-top: 0.4em; }
  @media (max-width: 900px) { .body { grid-column: 1 / -1; } }
</style>
