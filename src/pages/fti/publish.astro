---
import Base from "../../layouts/Base.astro";
const mail = "mailto:hello@citizeninfra.org?subject=Publishing%20with%20Funding%20to%20Impact";
const steps = [
  {
    title: "Start from the funding page you already have",
    body: "Your file points to your official pages, so they should answer the basics: what you fund and what you don't, who can apply, whether there's an application route right now, what support and deadlines apply, and when the information was last checked.",
  },
  {
    title: "List what you fund today",
    body: "Separate programmes from individual calls. For each one, say plainly whether people can apply: open, rolling, invitation-only, forecasted, or closed. If you have no open calls, or don't accept unsolicited proposals, say that too.",
  },
  {
    title: "Write fti-manifest.json",
    body: "Start from the example file and replace its content with yours: who you are, what the file covers, and one entry per call or programme. If you already publish CommonGrants records, link them instead of typing the data again.",
  },
  {
    title: "Say what you don't know",
    body: "\"Not specified\" is different from \"no restriction\". Leave a field out rather than guess. Your office address doesn't define who can apply, and a maximum award is not a promise.",
  },
  {
    title: "Check the file",
    body: "Run it through the schema with any JSON Schema validator, or send it to us and we'll check it for you.",
  },
  {
    title: "Put it on your website",
    body: "Upload the file anywhere on your site and link it from your funding page. If you publish an llms.txt file, link it from there too.",
  },
  {
    title: "Tell us",
    body: "Write to hello@citizeninfra.org with the file's address. We're looking for the first funders to publish, and we'll help you get it right.",
  },
  {
    title: "Keep it current",
    body: "When something changes, update the file and its revision. Set reviewedOn when someone has actually checked it. Keep closed calls in the file, marked as closed, instead of deleting them.",
  },
];
---
<Base
  title="How to publish with FtI · ItFtI"
  description="Eight plain steps for funders to publish an FtI file: start from your funding page, list what you fund, write fti-manifest.json, check it, put it on your website and tell us."
  current="fti"
>
  <section class="intro grid" aria-labelledby="t">
    <div class="head">
      <h1 id="t">How to publish with FtI</h1>
      <p class="tag rule-dash">For funding teams. No portal, no account.</p>
    </div>
    <div class="body">
      <p class="big">Eight steps from your existing funding page to a file people and agents can read.</p>
      <p>You'll need someone who can edit your website and a text editor. The file format is described on the <a href="/fti/format">format page</a>.</p>
      <p class="actions">
        <a class="slab" href="/examples/fti-manifest.example.json">Get the example file</a>
        <a class="slab-ghost" href="/fti/format">The format</a>
      </p>
    </div>
  </section>

  <section class="course grid" aria-labelledby="steps">
    <h2 id="steps" class="head">Steps</h2>
    <ol class="body steps">
      {steps.map((s) => (<li><h3>{s.title}</h3><p>{s.body}</p></li>))}
    </ol>
  </section>

  <section class="course grid" aria-labelledby="help">
    <h2 id="help" class="head">Need help?</h2>
    <div class="body">
      <p>FtI is at draft 0.1, and no funder has published with it yet. If you'd like to be among the first, write to us. We'll answer questions and check your file.</p>
      <p class="actions"><a class="slab" href={mail}>hello@citizeninfra.org</a></p>
    </div>
  </section>
</Base>

<style>
  .intro { padding-bottom: clamp(48px, 6vw, 88px); }
  .head { grid-column: 1 / span 4; align-self: start; position: sticky; top: 24px; }
  .body { grid-column: 5 / span 8; display: grid; gap: 1.1em; min-width: 0; }
  .big { font-family: var(--display); font-weight: 500; font-size: var(--step-2); line-height: 1.3; max-width: 26ch; }
  .tag { margin-top: 14px; padding-top: 10px; font-weight: 600; max-width: 26ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 0.4em; }
  .steps { list-style: none; padding: 0; gap: 0; counter-reset: step; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 3.2rem 1fr; column-gap: 16px; padding: 18px 0; border-top: 4px solid var(--red); max-width: none; }
  .steps li::before { content: counter(step); grid-row: span 2; font-family: var(--display); font-weight: 700; font-size: var(--step-2); line-height: 1; }
  .steps h3 { margin-bottom: 6px; }
  @media (max-width: 900px) {
    .head, .body { grid-column: 1 / -1; }
    .head { position: static; }
  }
</style>
