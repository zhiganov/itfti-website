---
import Base from "../layouts/Base.astro";
import FunderForm from "../components/FunderForm.astro";
const parts = [
  ["The file format", "fti-manifest.json on the funder's own site. Public, CC0.", "built"],
  ["The MCP server", "Lets agents find funders and calls in these files. Runs locally; not hosted yet.", "built"],
  ["Import adapters", "Read funders who haven't published a file. Experimental.", "planned"],
];
const publishes = [
  ["Priorities", "what it funds, and what it doesn't."],
  ["Eligibility", "who can apply, and from where."],
  ["Support", "type, amount, duration and eligible costs."],
  ["Availability", "open, rolling, invitation-only or closed."],
  ["Process", "the route, materials and deadlines."],
  ["Evidence", "what applicants should show."],
  ["Freshness", "who published it and when it was checked."],
];
const manifest = `"entries": [{
  "entryId": "synthetic-open",
  "kind": "opportunity",
  "commonGrants": { "record": {
    "title": "Synthetic open record",
    "status": { "value": "open" },
    "acceptedApplicantTypes": [{ "value": "individual" }],
    "funding": { "maxAwardAmount": { "amount": "1000.00", "currency": "EUR" } }
  } },
  "intake": {
    "mode": "public_application",
    "cadence": "fixed_deadline"
  }
}]`;
---
<Base
  title="Funding to Impact: a file format for funders · ItFtI"
  description="Funding to Impact is a file format funders publish on their own websites, with an MCP server that lets agents read it, so people can tell what a funder supports before they spend time applying. Draft 0.1, looking for its first funders."
  current="fti"
>
  <section class="intro grid" aria-labelledby="t">
    <div class="head">
      <h1 id="t">Funding to Impact</h1>
      <p class="tag rule-dash">For funders. Draft 0.1, looking for its first funders.</p>
    </div>
    <div class="body">
      <p class="big">Say what you fund, so the right people apply.</p>
      <p>One JSON file on your own site. People and their AI agents read it before anyone applies. Built on <a href="https://commongrants.org/">CommonGrants</a>, inspired by <a href="https://llmstxt.org/">llms.txt</a>.</p>
      <figure class="exhibit">
        <pre class="snippet"><code>{manifest}</code></pre>
        <figcaption>Part of the <a href="/examples/fti-manifest.example.json">fictional example file</a>.</figcaption>
      </figure>
      <p class="actions"><a class="slab" href="/fti/publish">How to publish</a><a class="slab-ghost" href="/fti/format">The file format</a></p>
    </div>
  </section>

  <section class="course grid" aria-labelledby="explain">
    <h2 id="explain" class="head">What a funder says</h2>
    <dl class="body publishes">
      {publishes.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
    </dl>
  </section>

  <section class="course grid" aria-labelledby="shape">
    <h2 id="shape" class="head">Three parts</h2>
    <ol class="body parts">
      {parts.map(([k, v, s]) => (<li class={s === "built" ? "rule-solid" : "rule-dash"}><h3>{k}</h3><p>{v}</p></li>))}
    </ol>
  </section>

  <section class="course grid" aria-labelledby="rules">
    <h2 id="rules" class="head">Ground rules</h2>
    <div class="body">
      <ul class="rules">
        <li>An interest isn't an open call.</li>
        <li>Past awards don't mean applications are open.</li>
        <li>Missing eligibility is unknown, not permission.</li>
      </ul>
    </div>
  </section>

  <section class="course grid" aria-labelledby="needs">
    <h2 id="needs" class="head">Need skilled help instead?</h2>
    <div class="body">
      <p>Organisations can publish the help they need, paid or pro bono, and their budgets.</p>
      <p class="actions"><a class="slab-ghost" href="/fti/needs">Needs and budgets format</a></p>
    </div>
  </section>

  <section class="course grid" aria-labelledby="now">
    <h2 id="now" class="head">Be one of the first</h2>
    <div class="body">
      <p class="rule-dash status">Draft 0.1. No funder has adopted FtI yet, and there's no hosted service.</p>
      <p>Fund work and want to publish with FtI? Tell us.</p>
      <FunderForm id="fti-contact" />
    </div>
  </section>
</Base>

<style>
  .intro { padding-bottom: clamp(48px, 6vw, 88px); }
  .head { grid-column: 1 / span 4; align-self: start; position: sticky; top: 24px; }
  .body { grid-column: 5 / span 8; display: grid; gap: 1.1em; min-width: 0; }
  .big { font-family: var(--display); font-weight: 500; font-size: var(--step-2); line-height: 1.3; max-width: 26ch; }
  .tag { margin-top: 14px; padding-top: 10px; font-weight: 600; max-width: 26ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 0.4em; }
  .publishes { gap: 0; }
  .exhibit { margin: 0; display: grid; gap: 8px; }
  .exhibit figcaption { font-size: 0.9rem; }
  .snippet { margin: 0; padding: 14px 16px; background: var(--red-wash); overflow-x: auto; font-size: 0.85rem; line-height: 1.5; }
  .snippet code { background: none; padding: 0; }
  .publishes div { display: grid; grid-template-columns: 11em 1fr; gap: 16px; padding: 0.75em 0; border-bottom: 2px solid var(--red); }
  .publishes dt { font-family: var(--display); font-weight: 700; }
  .publishes dd { margin: 0; max-width: 60ch; }
  .parts { list-style: none; padding: 0; gap: 26px; }
  .parts li { padding-top: 12px; max-width: none; }
  .parts h3 { margin-bottom: 6px; }
  .rules { list-style: none; padding: 0; font-family: var(--display); font-weight: 700; font-size: var(--step-1); line-height: 1.3; }
  .rules li { padding: 0.45em 0; border-bottom: 2px solid var(--red); }
  .status { padding-top: 12px; }
  @media (max-width: 900px) {
    .head, .body { grid-column: 1 / -1; }
    .head { position: static; }
    .publishes div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
