---
import Base from "../layouts/Base.astro";
import InstallCommands from "../components/InstallCommands.astro";
import CopyBlock from "../components/CopyBlock.astro";
const pluginInstall = `claude plugin marketplace add https://github.com/zhiganov/impact-to-funding.git
claude plugin install itf@impact-to-funding`;
const repo = "https://github.com/zhiganov/impact-to-funding";
const makes = [
  ["Claim checks", "every claim held to your evidence before anything goes public."],
  ["Lessons", "source-linked cases, patterns and lenses from others' work, null results kept. Your agent can search them through a local MCP server."],
  ["Support briefs", "a case for support, researched on funders' own pages, with open or closed status and the date checked."],
  ["Theories of change", "rebuilt from reports, notes and records you already have."],
  ["Sponsorship", "GitHub Sponsors profiles and tiers, and a check of your funding setup."],
  ["A way in", "your skills for existing organisations, if you don't have a project."],
  ["Impact cards", "a badge and card for a public report you've approved."],
  ["Mentors", "people you already know who could help, and a short request to send."],
];
const starts = [
  { title: "Find a useful contribution", prompt: "Help me find where my skills and time could be useful. Keep this private and contact no one." },
  { title: "Understand shared work", prompt: "Help me describe my part in this shared project and what we know about its effects." },
  { title: "Make a case for support", prompt: "Help me prepare a private case for sustaining this work. Don't invent impact." },
];
---
<Base
  title="Impact to Funding: an agent skill for builders · ItFtI"
  description="Impact to Funding is an open-source skill for your AI agent. It helps you find where your skills are useful, make an honest case for support, and work with others."
  current="itf"
>
  <section class="intro grid" aria-labelledby="t">
    <div class="head">
      <h1 id="t">Impact to Funding</h1>
      <p class="tag rule-solid">For builders. Experimental, v0.6.0. Open source.</p>
    </div>
    <div class="body">
      <p class="big">Put your skills towards real problems, and make a case for support that holds up.</p>
      <p>A skill for the AI agent you already use. Start from your situation: no theory of change, project or evidence needed.</p>
      <div class="example">
        <div>
          <h3>You might write</h3>
          <p>“Our guide changed how people repair things.”</p>
        </div>
        <div>
          <h3>ItF helps you say</h3>
          <p>“We handed out 60 guides. 12 of 15 readers we asked said it helped. We haven't checked whether repairs went up.”</p>
        </div>
      </div>
      <p class="fine">A fictional example.</p>
      <p class="actions"><a class="slab" href="#install">Install ItF</a><a class="slab-ghost" href={repo}>Source on GitHub</a></p>
    </div>
  </section>

  <section class="course grid" aria-labelledby="makes">
    <h2 id="makes" class="head">What it helps you do</h2>
    <div class="body">
      <dl class="publishes">
        {makes.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
      <figure class="exhibit">
        <img src="/examples/impact-card-fictional.svg" width="520" height="232" loading="lazy"
          alt="A fictional impact card for the Lantern repair guide. Printed and handed out 60 access guides: supported, self-reported. 12 of 15 readers asked said the guide helped: partly supported, self-reported. Households repaired appliances: not assessed." />
        <figcaption>A fictional impact card. Nothing is called proven, and the unchecked claim says so.</figcaption>
      </figure>
      <p>With others, too: profiles, mentors, guilds and matchmaking. <a href="/#together">What's live and what's planned</a>.</p>
    </div>
  </section>

  <section class="course grid" aria-labelledby="install">
    <h2 id="install" class="head">Install</h2>
    <div class="body">
      <p>Pick your agent and run the command in your terminal.</p>
      <InstallCommands />
      <h3 id="plugin" class="sub">Or the Claude Code plugin</h3>
      <CopyBlock code={pluginInstall} />
      <p>Then type <code>/itf:impact-to-funding</code>. It includes the reference-library MCP server and needs Node.js 22 or later. Keep the plugin or the skill folder, not both.</p>
      <p class="fine">Claude Code gets v0.6.0; Codex CLI and OpenCode get older versions. <a href="https://github.com/zhiganov/impact-to-funding/blob/main/docs/install.md">Install guide</a> · <a href="https://github.com/zhiganov/impact-to-funding/blob/main/mcp/README.md">MCP server for other agents</a></p>
    </div>
  </section>

  <section class="course grid" aria-labelledby="start">
    <h2 id="start" class="head">Three ways to start</h2>
    <div class="body">
      <ol class="starts">
        {starts.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <blockquote><p>{s.prompt}</p></blockquote>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="course grid" aria-labelledby="limits">
    <h2 id="limits" class="head">Limits</h2>
    <div class="body">
      <ul class="ledger">
        <li class="rule-solid"><strong>Your agent's provider sees what it reads.</strong> Share only what you may.</li>
        <li class="rule-solid"><strong>Nothing happens without you.</strong> No publishing, contacting, applying or paying.</li>
        <li class="rule-solid"><strong>No certification.</strong> Outputs don't prove impact.</li>
        <li class="rule-dash"><strong>Early.</strong> Trials were small. Usefulness and fundraising results aren't verified.</li>
      </ul>
      <p class="fine">Writing CC BY-SA 4.0, code MIT. Draws on public Moral Ambition principles; not affiliated with or endorsed by the School for Moral Ambition or Rutger Bregman.</p>
    </div>
  </section>
</Base>

<style>
  .intro { padding-bottom: clamp(48px, 6vw, 88px); }
  .head { grid-column: 1 / span 4; align-self: start; position: sticky; top: 24px; }
  .body { grid-column: 5 / span 8; display: grid; gap: 1.1em; min-width: 0; }
  .big { font-family: var(--display); font-weight: 500; font-size: var(--step-2); line-height: 1.3; max-width: 26ch; }
  .tag { margin-top: 14px; padding-top: 10px; font-weight: 600; max-width: 26ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 0.4em; }
  .sub { margin-top: 0.9em; }
  .starts { list-style: none; padding: 0; display: grid; gap: 0; counter-reset: s; }
  .starts li { padding: 18px 0; border-top: 4px solid var(--red); max-width: none; }
  .starts h3 { margin-bottom: 10px; }
  blockquote { margin: 0; padding: 14px 18px; background: var(--red-wash); font-size: 0.95rem; }
  .ledger { list-style: none; padding: 0; display: grid; gap: 20px; }
  .publishes { display: grid; gap: 0; }
  .publishes div { display: grid; grid-template-columns: 9.5em 1fr; gap: 16px; padding: 0.7em 0; border-bottom: 2px solid var(--red); }
  .publishes dt { font-family: var(--display); font-weight: 700; }
  .publishes dd { margin: 0; max-width: 60ch; }
  .ledger li { padding-top: 12px; }
  .example { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 8px solid var(--red); }
  .example > div { padding: 22px 24px; max-width: none; }
  .example > div + div { border-left: 8px solid var(--red); }
  .example h3 { margin-bottom: 0.4em; }
  .fine { font-size: 0.9rem; }
  .exhibit { margin: 0; display: grid; gap: 8px; }
  .exhibit img { width: 100%; max-width: 560px; height: auto; display: block; }
  .exhibit figcaption { font-size: 0.9rem; max-width: 60ch; }
  @media (max-width: 900px) {
    .head, .body { grid-column: 1 / -1; }
    .head { position: static; }
    table, thead, tbody, tr, th, td { display: block; }
    thead { display: none; }
    tr { border-bottom: 2px solid var(--red); padding: 0.6em 0; }
    td { border: 0; padding: 0.15em 0; }
    .publishes div { grid-template-columns: 1fr; gap: 2px; }
    .example { grid-template-columns: 1fr; }
    .example > div + div { border-left: 0; border-top: 8px solid var(--red); }
  }
</style>
