---
// Navigation is the name: each of the five letters I-t-F-t-I opens one part of the site.
interface Props { current: "home" | "itf" | "loop" | "fti" | "status" }
const { current } = Astro.props;
const letters = [
  { id: "home", glyph: "I", label: "Home", shortLabel: "Home", href: "/" },
  { id: "itf", glyph: "t", label: "Impact to Funding", shortLabel: "Builders", href: "/itf" },
  { id: "loop", glyph: "F", label: "How the two meet", shortLabel: "The loop", href: "/#loop" },
  { id: "fti", glyph: "t", label: "Funding to Impact", shortLabel: "Funders", href: "/fti" },
  { id: "status", glyph: "I", label: "What exists today", shortLabel: "Status", href: "/#status" },
];
---
<nav class="letters" aria-label="Site">
  <ul>
    {letters.map((l) => (
      <li>
        <a href={l.href} aria-label={l.shortLabel === l.label ? l.label : `${l.shortLabel}: ${l.label}`} aria-current={l.id === current ? "page" : undefined} class:list={{ on: l.id === current }}>
          <span class="glyph" aria-hidden="true">{l.glyph}</span>
          <span class="label" aria-hidden="true"><span class="label-full">{l.label}</span><span class="label-short">{l.shortLabel}</span></span>
        </a>
      </li>
    ))}
  </ul>
  <a class="home" href="/">itfti.org</a>
</nav>

<style>
  .letters { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  ul { list-style: none; padding: 0; display: flex; gap: 10px; }
  li { max-width: none; }
  a { text-decoration: none; }
  ul a { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .glyph {
    font-family: var(--display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    padding-bottom: 4px;
    border: 4px solid var(--red);
    color: var(--red);
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  ul a:hover .glyph, .on .glyph { background: var(--red); color: var(--paper); }
  .label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    max-width: 84px;
    text-align: center;
    line-height: 1.2;
  }
  .label-short { display: none; }
  .home {
    font-family: var(--display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 16px;
  }
  @media (max-width: 720px) {
    .glyph { width: 44px; height: 44px; font-size: 24px; border-width: 3px; }
    ul { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; width: 100%; max-width: 420px; }
    .label { font-size: 14px; letter-spacing: 0; text-transform: none; max-width: 100%; }
    .label-full { display: none; }
    .label-short { display: inline; }
    .home { display: none; }
    .letters { flex-direction: column; gap: 0; }
  }
</style>
